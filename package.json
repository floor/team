{
  "name": "team",
  "version": "0.1.0-alpha.0",
  "description": "Set up, change and watch a project's team of AI agents from one file",
  "license": "MIT",
  "type": "module",
  "bin": { "team": "dist/cli.js" },
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=22" },
  "repository": { "type": "git", "url": "git+https://github.com/floor/team.git" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "tsc -p tsconfig.build.json",
    "ci": "bun run typecheck && bun test && bun run build && node dist/cli.js --version"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
