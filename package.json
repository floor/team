{
  "name": "team",
  "version": "0.3.0",
  "description": "Set up, change and watch a project's team of AI agents from one file",
  "keywords": [
    "ai-agents",
    "agents",
    "multi-agent",
    "orchestration",
    "herdr",
    "cli"
  ],
  "homepage": "https://github.com/floor/team#readme",
  "bugs": { "url": "https://github.com/floor/team/issues" },
  "license": "MIT",
  "type": "module",
  "bin": { "team": "dist/cli.js" },
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "examples", "schema", "README.md", "LICENSE"],
  "engines": { "node": ">=22" },
  "repository": { "type": "git", "url": "git+https://github.com/floor/team.git" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "e2e": "bun scripts/e2e.ts",
    "build": "bun scripts/build.ts",
    "conformance": "bun scripts/conformance.ts --impl \"node dist/cli.js conformance-adapter\"",
    "coverage": "bun scripts/coverage.ts",
    "coverage:check": "bun scripts/coverage.ts --check",
    "schema:check": "bun scripts/schema.ts",
    "contract": "bun scripts/contract.ts",
    "contract:check": "bun scripts/contract.ts --check",
    "exit-codes:check": "bun scripts/exit-codes.ts --check",
    "ci": "bun run typecheck && bun test && bun run build && node dist/cli.js --version && bun run conformance && bun run schema:check && bun run contract:check && bun run coverage:check && bun run exit-codes:check"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
